{
  "name": "pulse",
  "productName": "Pulse",
  "version": "0.1.0",
  "description": "A notch at the top of your screen for the things you reach for all day.",
  "main": "./out/main/index.js",
  "updateRepo": "singhrajatpratap1905-coder/PULSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "install-app": "node scripts/install.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "koffi": "2.9.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "zustand": "5.0.1"
  },
  "build": {
    "appId": "com.pulse.app",
    "productName": "Pulse",
    "copyright": "Pulse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse",
      "include": "build/installer.nsh",
      "artifactName": "Pulse-Setup-${version}.exe"
    }
  }
}
